<exercise>
<statement>
<p>Simplify</p>

<p>
<md>\frac{
\frac1x+\frac1y
}{
\frac1x-\frac1y
}.</md>
</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Show that</p>

<p>
<md>|ab|
=
|a||b|.</md>
</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Prove the reverse triangle inequality.</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Compute</p>

