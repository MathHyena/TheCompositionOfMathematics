<statement>
<p>Prove</p>

<p>
<md>\sum_{k=0}^{n}
\binom{n}{k}
=
2^n.</md>
</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Prove</p>

<p>
<md>\sum_{k=0}^{n}
(-1)^k
\binom{n}{k}
=
0</md>
</p>

<p>for <m>n\geq1</m>.</p>
