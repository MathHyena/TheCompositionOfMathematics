<p>
<md>f(x)=\sin(4x).</md>
</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Differentiate</p>

<p>
<md>f(x)=\cos(x^2).</md>
</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Differentiate</p>

<p>
<md>f(x)=\tan(5x-1).</md>
</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Differentiate</p>

<p>
<md>f(x)=\sec(x^3).</md>
</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Differentiate</p>

<p>
<md>f(x)=\csc(2x).</md>
</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Differentiate</p>

<p>
<md>f(x)=\cot(7x).</md>
</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Differentiate</p>

<p>
<md>f(x)=\arcsin(2x).</md>
</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Differentiate</p>

<p>
<md>f(x)=\arccos(x^2).</md>
</p>
