<statement>
<p>State the convergence domain of the exponential MGF.</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Find the characteristic function of a Bernoulli variable.</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Find the characteristic function of a Poisson variable.</p>
</statement>
</exercise>

<exercise>
<statement>
