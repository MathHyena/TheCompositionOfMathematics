<p>Find</p>

<p>
<md>\mathcal{L}\{e^{2t}\cos3t\}.</md>
</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Find</p>

<p>
<md>\mathcal{L}^{-1}
\left\{
\frac1{s+4}
\right\}.</md>
