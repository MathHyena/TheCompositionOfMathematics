<p>
<md>u_3(t).</md>
</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Find</p>

<p>
<md>\mathcal{L}^{-1}
\left\{
\frac{
e^{-2s}
}{
s
}
\right\}.</md>
</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Find</p>

<p>
<md>\mathcal{L}
\{
\delta(t-5)
\}.</md>
</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Find the poles of</p>

<p>
<md>H(s)
=
\frac{
s+3
}{
(s+1)(s+4)
