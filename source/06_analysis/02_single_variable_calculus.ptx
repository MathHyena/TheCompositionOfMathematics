<exercise>
<statement>
<p>Find the tangent line to</p>

<p>
<md>f(x)=x^2+1</md>
</p>

<p>at <m>x=2</m>.</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Find the linearization of</p>

<p>
<md>f(x)=\sqrt{x}</md>
</p>

<p>at <m>x=4</m>.</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Find the critical numbers of</p>

<p>
<md>f(x)=x^3-3x.</md>
</p>
</statement>
