</statement>
</exercise>

<exercise>
<statement>
<p>Suppose</p>

<p>
<md>\mu
\sim
N(0,4),</md>
</p>

<p>
<md>\sigma^2=9,
\qquad
n=9,
\qquad
\overline{x}=3.</md>
</p>

<p>Find the posterior precision.</p>
