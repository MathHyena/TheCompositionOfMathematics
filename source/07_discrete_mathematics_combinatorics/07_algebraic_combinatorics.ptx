<exercise>
<statement>
<p>Derive the <m>q</m>-Pascal recurrence for Gaussian binomial coefficients.</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Prove that</p>

<p>
<md>\begin{bmatrix}
n\\
k
\end{bmatrix}_q</md>
</p>

<p>counts <m>k</m>-dimensional subspaces of</p>

<p>
<md>\mathbb{F}_q^n.</md>
</p>
</statement>
</exercise>

<exercise>
<statement>
<p>Prove</p>

<p>
<md>[n]_q!
=
\sum_{\pi\in S_n}
q^{\operatorname{inv}(\pi)}.</md>
</p>
</statement>
</exercise>

<exercise>
<statement>
